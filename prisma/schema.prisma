generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  passwordHash         String?
  firebaseUid          String?               @unique
  image                String?
  name                 String
  phone                String?
  role                 String                @default("CITIZEN")
  departmentId         String?
  karma                Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
  assignments          Assignment[]          @relation("Assignments")
  assignedComplaints   Complaint[]           @relation("AssignedWorker")
  complaints           Complaint[]           @relation("Reporter")
  notifications        Notification[]        @relation("Notifications")
  department           Department?           @relation(fields: [departmentId], references: [id])
  workerApplications   WorkerApplication[]
  workerProfile        WorkerProfile?
  officialApplications OfficialApplication[]
  officialProfile      OfficialProfile?
}

/// Verified operational worker record (Phase 2A). Created ONLY through the
/// official approval transaction — never directly. One per user.
/// Carries the structured, queryable capability data that Phase 2B/2C will
/// use for automatic worker assignment (department, skills, equipment,
/// availability, service area). Employee ID is the worker's primary identity
/// attribute (verified by the approving official, unique in the domain).
model WorkerProfile {
  id                   String     @id @default(cuid())
  userId               String     @unique
  employeeId           String     @unique
  departmentId         String
  designation          String?
  skills               String[]
  equipment            String[]
  availability         String     @default("AVAILABLE")
  serviceAreas         String[]
  baseLat              Float?
  baseLng              Float?
  maxActiveAssignments Int        @default(3)
  phone                String?
  workEmail            String?
  approvedById         String
  approvedAt           DateTime   @default(now())
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @default(now()) @updatedAt
  department           Department @relation("WorkerProfileDepartment", fields: [departmentId], references: [id])
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@index([availability])
}

/// Worker onboarding application (Phase 2A). A citizen must apply and be
/// verified by an official before gaining WORKER privileges. Lifecycle:
/// PENDING → APPROVED (creates WorkerProfile + role transition, transactional)
/// or PENDING → REJECTED (with reason; no privileges).
model WorkerApplication {
  id              String     @id @default(cuid())
  applicantId     String
  employeeId      String
  departmentId    String
  designation     String?
  skills          String[]
  equipment       String[]
  experience      String?
  serviceAreas    String[]
  phone           String?
  workEmail       String?
  status          String     @default("PENDING")
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt
  applicant       User       @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  department      Department @relation("WorkerApplicationDepartment", fields: [departmentId], references: [id])

  @@unique([employeeId, status])
  @@unique([applicantId, status])
  @@index([status, createdAt])
  @@index([departmentId])
}

model StoredFile {
  id        String   @id @default(cuid())
  key       String   @unique
  mime      String
  bytes     Bytes
  size      Int
  createdAt DateTime @default(now())

  @@index([key])
}

model Department {
  id                   String                @id @default(cuid())
  name                 String                @unique
  code                 String                @unique
  slaNote              String?
  complaints           Complaint[]           @relation("DepartmentComplaints")
  workers              User[]
  workerApplications   WorkerApplication[]   @relation("WorkerApplicationDepartment")
  workerProfiles       WorkerProfile[]       @relation("WorkerProfileDepartment")
  officialApplications OfficialApplication[] @relation("OfficialApplicationDepartment")
  officialProfiles     OfficialProfile[]     @relation("OfficialProfileDepartment")
}

model Complaint {
  id                     String          @id @default(cuid())
  refCode                String          @unique
  title                  String
  description            String
  category               String
  severity               String
  priority               Int
  status                 String          @default("RECEIVED")
  source                 String          @default("CITIZEN")
  lat                    Float?
  lng                    Float?
  address                String?
  ward                   String?
  accuracyMeters         Float?
  locationSource         String?
  locationCapturedAt     DateTime?
  language               String          @default("en")
  transcript             String?
  originalText           String?
  photoKey               String?
  resolutionKey          String?
  aiConfidence           Float?
  aiSummary              String?
  departmentId           String?
  reporterId             String
  assignedToId           String?
  slaHours               Int?
  slaDueAt               DateTime?
  isOverdue              Boolean         @default(false)
  verified               Boolean?
  verificationConfidence Float?
  verificationReason     String?
  verificationProvider   String?
  verifiedAt             DateTime?
  verificationResult     String?
  escalationCount        Int             @default(0)
  reopenedCount          Int             @default(0)
  duplicateOfId          String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  assignedAt             DateTime?
  startedAt              DateTime?
  submittedAt            DateTime?
  resolvedAt             DateTime?
  closedAt               DateTime?
  activeAssignmentId     String?         @unique
  agentActivities        AgentActivity[]
  assignments            Assignment[]
  activeAssignment       Assignment?     @relation("ActiveAssignment", fields: [activeAssignmentId], references: [id])
  assignedTo             User?           @relation("AssignedWorker", fields: [assignedToId], references: [id])
  department             Department?     @relation("DepartmentComplaints", fields: [departmentId], references: [id])
  duplicateOf            Complaint?      @relation("DuplicateOf", fields: [duplicateOfId], references: [id])
  duplicates             Complaint[]     @relation("DuplicateOf")
  reporter               User            @relation("Reporter", fields: [reporterId], references: [id])
  escalations            Escalation[]
  notifications          Notification[]  @relation("Notifications")
  events                 TimelineEvent[]

  @@index([status])
  @@index([category])
  @@index([departmentId])
  @@index([assignedToId])
  @@index([lat, lng])
  @@index([createdAt])
}

model TimelineEvent {
  id          String    @id @default(cuid())
  complaintId String
  type        String
  actor       String    @default("system")
  title       String
  detail      String?
  createdAt   DateTime  @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

model AgentActivity {
  id          String     @id @default(cuid())
  complaintId String?
  runId       String?
  agent       String
  action      String
  summary     String
  detail      String?
  createdAt   DateTime   @default(now())
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([runId])
  @@index([agent, action])
}

model Escalation {
  id          String    @id @default(cuid())
  complaintId String
  level       Int       @default(1)
  reason      String
  createdAt   DateTime  @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

/// Assignment lifecycle record (Phase 2B). Every automatic or manual
/// assignment decision creates an Assignment row — history is NEVER
/// overwritten: reassignment/override closes the previous row (REJECTED /
/// CANCELLED / REASSIGNED) and creates a new one. Complaint.activeAssignmentId
/// points at the single open assignment.
/// Official onboarding application. A CITIZEN or WORKER applies and an ADMIN
/// verifies them before gaining OFFICIAL privileges. Lifecycle:
/// PENDING → APPROVED (creates OfficialProfile + role transition, transactional)
/// or PENDING → REJECTED (with reason; no privileges). The municipal employee
/// ID is the applicant's real-world staff identifier (verified by the admin);
/// the CivicShield Official ID is generated server-side only at approval.
model OfficialApplication {
  id                 String           @id @default(cuid())
  applicantId        String
  employeeId         String
  departmentId       String
  designation        String?
  municipality       String
  officialEmail      String?
  phone              String?
  serviceAreas       String[]
  experience         String?
  applicationDetails String?
  status             String           @default("PENDING")
  reviewedById       String?
  reviewedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt
  applicant          User             @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  department         Department       @relation("OfficialApplicationDepartment", fields: [departmentId], references: [id])
  profile            OfficialProfile?

  @@unique([employeeId, status])
  @@unique([applicantId, status])
  @@index([status, createdAt])
  @@index([departmentId])
}

/// Verified operational official record. Created ONLY through the admin
/// approval transaction — never directly. One per user. officialId is the
/// server-generated CivicShield platform identifier (CS-OFF-0001, …) —
/// immutable, collision-safe, unrelated to email or Firebase UID. The
/// municipal employee ID stays on the application as the real-world
/// identifier the admin verified.
model OfficialProfile {
  id            String               @id @default(cuid())
  userId        String               @unique
  officialId    String               @unique
  departmentId  String
  designation   String?
  municipality  String
  serviceAreas  String[]
  applicationId String?              @unique
  phone         String?
  workEmail     String?
  approvedById  String
  approvedAt    DateTime             @default(now())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @default(now()) @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Department           @relation("OfficialProfileDepartment", fields: [departmentId], references: [id])
  application   OfficialApplication? @relation(fields: [applicationId], references: [id])

  @@index([departmentId])
}

/// Assignment lifecycle record (Phase 2B). Every automatic or manual
/// assignment decision creates an Assignment row — history is NEVER
/// overwritten: reassignment/override closes the previous row (REJECTED /
/// CANCELLED / REASSIGNED) and creates a new one. Complaint.activeAssignmentId
/// points at the single open assignment.
model Assignment {
  id                   String         @id @default(cuid())
  complaintId          String
  workerId             String
  previousAssignmentId String?
  slaWarnedAt          DateTime?
  slaBreachedAt        DateTime?
  status               String         @default("OFFERED")
  mode                 String         @default("AUTO")
  policyVersion        String
  decision             String?
  reason               String?
  respondedAt          DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  closedAt             DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  complaint            Complaint      @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  previousAssignment   Assignment?    @relation("Reassignments", fields: [previousAssignmentId], references: [id])
  reassignments        Assignment[]   @relation("Reassignments")
  worker               User           @relation("Assignments", fields: [workerId], references: [id])
  activeForComplaint   Complaint?     @relation("ActiveAssignment")
  notifications        Notification[] @relation("Notifications")

  @@index([complaintId])
  @@index([workerId, status])
  @@index([status])
  @@index([createdAt])
}

/// In-app notification (Phase 3). Created only from real domain events
/// (assignment offered/accepted/rejected/reassigned/started/completed,
/// SLA warning/breach, escalation, official override) — never from route
/// calls alone. dedupeKey is a deterministic event key with a database
/// UNIQUE constraint: repeated sweeps/retries cannot create duplicates.
model Notification {
  id           String      @id @default(cuid())
  recipientId  String
  type         String
  title        String
  body         String?
  complaintId  String?
  assignmentId String?
  dedupeKey    String?     @unique
  data         String?
  readAt       DateTime?
  createdAt    DateTime    @default(now())
  assignment   Assignment? @relation("Notifications", fields: [assignmentId], references: [id])
  complaint    Complaint?  @relation("Notifications", fields: [complaintId], references: [id], onDelete: Cascade)
  recipient    User        @relation("Notifications", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([complaintId])
}
