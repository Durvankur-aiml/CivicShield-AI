[TEMPLATE]

# ── CivicShield AI — environment template ──────────────────────────────
# Copy to .env (dev) / .env.local and fill in. NEVER commit real secrets.
# Canonical database strategy: PostgreSQL everywhere.
#   • Local development: any local PostgreSQL instance (Docker, native, or a
#     free hosted dev database).
#   • Production/demo deployment: Supabase PostgreSQL (see README "Database").
#   • `npm run demo:reset` syncs the schema (`prisma db push --force-reset`)
#     and re-seeds DEMO data — it requires `--yes` when pointed at PostgreSQL.

# ── Database (PostgreSQL — required) ────────────────────────────────────
# Direct connection used by Prisma for queries AND (without DIRECT_URL) for
# migrations/schema push. Example local:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/civicshield_dev"
# Supabase example (session pooler):
# DATABASE_URL="postgresql://postgres.<PROJECT>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# Optional: separate NON-pooled connection used by Prisma CLI for schema
# push/migrations when DATABASE_URL points at a pooled connection (Supabase
# transaction pooler does not support advisory locks used by the CLI).
# If unset, Prisma uses DATABASE_URL for everything.
# DIRECT_URL="postgresql://postgres.<PROJECT>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# ── Session signing secret — REQUIRED ──────────────────────────────────
# The app FAILS CLOSED in production if this is missing/empty — there is no
# production fallback. Generate: openssl rand -hex 32
AUTH_SECRET=""

# ── Authentication: Firebase / Google (REAL auth; no demo accounts) ────
# PUBLIC web config — safe for the browser (Firebase web API keys are public
# identifiers, NOT secrets; security is enforced server-side via Admin SDK):
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""      # <PROJECT_ID>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# SERVER-SIDE ONLY — Firebase Admin service account (pick ONE method).
# NEVER put these in NEXT_PUBLIC_* variables, source files, or git.
# Method 1 (recommended for deployments): base64 of the service-account JSON
#   (generate: base64 -w0 service-account.json  /  PowerShell:
#    [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json")))
# FIREBASE_SERVICE_ACCOUNT_B64=""
# Method 2: path to the JSON file (kept OUTSIDE the repository)
# FIREBASE_SERVICE_ACCOUNT_PATH="C:\\secrets\\firebase-service-account.json"
# Method 3: standard Google ADC variable
# GOOGLE_APPLICATION_CREDENTIALS=""

# Optional server-side staff mapping (no role selection exists in the UI).
# Format: "email:ROLE[:DEPT_CODE],..." — bare emails mean OFFICIAL.
# Example: "me@example.com:OFFICIAL,worker2@example.com:WORKER:SWM"
# STAFF_EMAILS=""

# ── AI providers (all optional; labeled dev providers used when absent) ─
# YOLOv8 microservice (see /vision-service). When set, real model inference is used.
# NOTE: the CivicAI `best.pt` weight is NOT distributed with this repository —
# see vision-service/README.md. Until the weight is installed at
# vision-service/model/best.pt, the service reports degraded and the web app
# falls back to its clearly-labeled development vision provider.
# YOLO_SERVICE_URL="http://localhost:8000"
# Service-side: path to the CivicAI trained weight (inside vision-service).
# YOLO_MODEL_PATH="./model/best.pt"

# Amazon Bedrock (when AWS keys are present, real LLM triage is used)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="ap-south-1"
# BEDROCK_MODEL_ID="anthropic.claude-3-haiku-20240307-v1:0"

# ── Storage (database-backed default) ──────────────────────────────────
MAX_UPLOAD_MB="8"
# STORAGE_DRIVER="local"   # S3 driver is a documented extension point

# ── SLA hours by severity (defaults shown) ─────────────────────────────
# SLA_HOURS_CRITICAL=12
# SLA_HOURS_HIGH=24
# SLA_HOURS_MEDIUM=48
# SLA_HOURS_LOW=72

# ── Duplicate detection tuning (defaults shown) ────────────────────────
# DUPLICATE_RADIUS_M=150
# DUPLICATE_WINDOW_H=72

# ── Cron protection for /api/cron/sla ──────────────────────────────────
# REQUIRED for the scheduled SLA sweep (vercel.json cron). Vercel sends the
# value as `Authorization: Bearer $CRON_SECRET`; manual calls may use either
# `Authorization: Bearer <secret>` or `x-cron-secret: <secret>`.
# CRON_SECRET="generate-a-random-string"

# ── Dev-only rate-limit multiplier (default 1; do NOT set in production) ─
# RATE_LIMIT_MULTIPLIER="20"

# ── Test-only script configuration (never commit real personal values) ──
# scripts/verify-roles.mjs reads accounts from this variable:
#   CIVICSHIELD_ROLE_ACCOUNTS="<firebaseUid>:OFFICIAL:LabelA,<uid>:WORKER:LabelB"
# scripts/audit-walkthrough.mjs requires one of:
#   TEST_USER_UID=<firebaseUid>   (or pass the uid as argv[3])
# scripts/prod-auth-smoke.mjs requires a baseUrl argument (no default URL).
